{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsu.dev/schemas/operations-ui-evals-v2.json",
  "title": "Operations UI v2 evaluation fixtures",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "operations-ui-evals-v2"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "expected": {
            "type": "object",
            "required": ["select", "must_not_select", "profile", "artifact_scope", "mode", "requirements", "prohibitions"],
            "properties": {
              "select": {"$ref": "#/$defs/skillIds"},
              "must_not_select": {"$ref": "#/$defs/skillIds"},
              "profile": {"const": "operations-ui"},
              "artifact_scope": {"enum": ["proposal", "figma", "implementation", "live"]},
              "mode": {"enum": ["greenfield", "redesign", "audit"]},
              "requirements": {"$ref": "#/$defs/stringSet"},
              "prohibitions": {"$ref": "#/$defs/stringSet"}
            },
            "allOf": [
              {
                "anyOf": [
                  {"properties": {"select": {"minItems": 1}}},
                  {"properties": {"must_not_select": {"minItems": 1}}}
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "skillIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "operations-ui:design-operations-ui",
          "operations-ui:redesign-operations-ui",
          "operations-ui:audit-operations-ui",
          "operations-ui:figma-operations-flow"
        ]
      }
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
