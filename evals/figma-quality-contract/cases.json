{
  "schema_version": "figma-quality-contract-v1",
  "cases": [
    {
      "id": "reading-order-reuses-existing-type-and-spacing",
      "scenario": "기존 Text Style과 semantic color가 있는 주문 상세 화면을 정리한다. 제목, 상태·건수, field label과 도움말이 모두 같은 간격과 강약으로 놓여 있다. 좁은 폭에서는 일본어 도움말이 여러 줄이 된다.",
      "expected": ["group-related-content-by-user-task", "align-reading-starts-preserve-numeric-alignment", "map-used-text-roles-to-existing-styles", "reuse-spacing-tokens-for-group-relationships", "preserve-readable-secondary-text-contrast", "verify-long-localized-copy-and-style-bindings"],
      "must_not": ["generate-five-new-type-roles-unconditionally", "make-all-gaps-identical", "dim-helper-text-below-readable-contrast", "wrap-every-group-in-a-new-card"]
    },
    {
      "id": "nested-surface-radius-uses-actual-inset",
      "scenario": "원호형 radius 10인 surface 안에 같은 곡선의 surface가 있다. border 1과 padding 3을 합친 inset은 4이며 기존 radius token은 10과 6이다. 별도 예시에서는 outer radius 6보다 inset 8이 크다.",
      "expected": ["measure-inset-between-corresponding-contours", "consider-inner-radius-six-for-inset-four", "clamp-negative-radius-to-zero", "reuse-compatible-existing-radius-token", "verify-local-surface-rendering"],
      "must_not": ["subtract-padding-only-when-border-contributes", "emit-negative-radius", "change-global-padding-or-radius-scale"]
    },
    {
      "id": "nested-control-preserves-independent-shape",
      "scenario": "corner smoothing을 쓰는 카드 안에 브랜드 pill 버튼이 있고 좌우·상하 여백이 다르다. 버튼은 기존 library instance다.",
      "expected": ["recognize-nonuniform-inset-and-different-curve", "preserve-independent-control-shape", "inspect-existing-component-before-local-adjustment"],
      "must_not": ["apply-nested-radius-formula-unconditionally", "detach-library-instance-to-change-radius", "replace-pill-radius-with-card-minus-padding"]
    },
    {
      "id": "auto-layout-uses-semantic-relationships",
      "scenario": "세로 form 안에 label, input, help text와 action row가 있다.",
      "expected": ["structural-auto-layout", "semantic-layer-names", "content-driven-spacing"],
      "must_not": ["absolute-position-all-children", "auto-layout-every-decorative-layer"]
    },
    {
      "id": "fill-requires-auto-layout-parent",
      "scenario": "child가 아직 일반 frame 아래에 있을 때 horizontal FILL을 요청한다.",
      "expected": ["append-to-auto-layout-parent-before-fill", "verify-axis-sizing"],
      "must_not": ["set-invalid-fill-and-continue"]
    },
    {
      "id": "layout-model-follows-content-relationship",
      "scenario": "responsive 웹 dashboard에 한 줄 toolbar, 줄바꿈되는 filter chip과 row·column track 및 span이 중요한 card 영역이 있다. 각 card 안에는 vertical content와 horizontal action row가 중첩된다.",
      "expected": ["horizontal-auto-layout-for-one-axis-toolbar", "wrap-auto-layout-for-reflowing-chips", "grid-auto-layout-for-two-axis-card-tracks", "preserve-nested-one-axis-card-relationships", "layout-grid-is-visual-guide-only", "record-applicable-flex-grid-handoff-properties", "verify-narrow-wide-resize"],
      "must_not": ["force-one-layout-model-for-every-container", "flatten-independent-one-axis-relationships", "use-layout-grid-as-responsive-structure", "mirror-dom-one-to-one", "simulate-two-axis-tracks-with-absolute-positioning"]
    },
    {
      "id": "non-web-handoff-keeps-platform-native-intent",
      "scenario": "iOS 화면의 stack과 adaptive collection을 Figma에서 구성하고 SwiftUI 구현으로 handoff한다.",
      "expected": ["record-structural-layout-intent", "map-to-platform-native-layout-primitives", "preserve-resize-and-content-relationships"],
      "must_not": ["require-css-flex-grid-terms", "mirror-web-dom-structure"]
    },
    {
      "id": "responsive-content-extremes",
      "scenario": "카드 목록이 0개, 1개, 20개이고 제목은 짧은 영어와 긴 일본어 번역을 가진다.",
      "expected": ["test-zero-one-many", "test-short-long-localized-copy", "test-narrow-wide"],
      "must_not": ["validate-default-content-only"]
    },
    {
      "id": "component-and-icon-reuse-preserve-source",
      "scenario": "기존 library에 Search icon component가 있고 버튼에는 state, size, icon과 label이 있다.",
      "expected": ["variant-for-state-and-size", "instance-swap-when-configurable", "text-property-for-label", "preserve-semantic-color"],
      "must_not": ["emoji-icon", "redraw-with-lines", "detach-instance-silently"]
    },
    {
      "id": "missing-exact-icon-remains-blocked",
      "scenario": "요청한 brand icon의 정확한 asset을 찾지 못했다.",
      "expected_status": "blocked",
      "expected": ["request-or-locate-exact-asset", "report-blocked-scope"],
      "must_not": ["invent-brand-mark", "use-similar-icon-without-disclosure"]
    },
    {
      "id": "official-mcp-write-has-bounded-target-and-readback",
      "scenario": "Codex가 한 Figma frame의 responsive layout을 수정한다.",
      "expected": ["figma-figma-use-prerequisite", "registered-official-figma-mcp", "explicit-target", "unchanged-area-boundary", "readback-structure-and-screenshot-when-available"],
      "must_not": ["unbounded-canvas-write", "parallel-writers-in-same-conflict-domain", "raw-mcp-fallback"]
    },
    {
      "id": "manual-companion-audit-is-factual-not-design-judgment",
      "scenario": "사용자가 companion으로 선택한 subtree의 Auto Layout을 audit한다.",
      "expected": ["manual-desktop-execution", "selection-scoped-read-only-plan", "json-safe-structure-facts", "report-observed-finding-with-node-id"],
      "must_not": ["agent-callable-companion", "automatic-aesthetic-pass", "mutation-during-audit"]
    },
    {
      "id": "readback-failure-remains-visible",
      "scenario": "exact rename mutation 뒤 readback이 실패했다.",
      "expected_status": "failed",
      "expected": ["report-readback-failed", "report-mutation-may-have-occurred", "continue-independent-targets"],
      "must_not": ["claim-applied", "automatic-rollback"]
    },
    {
      "id": "static-verification-does-not-prove-live-canvas",
      "scenario": "schema, test, typecheck와 bundle은 통과했지만 official connector exposure와 live canvas는 실행하지 않았다.",
      "expected_status": "not_run",
      "expected": ["report-static-checks", "report-connector-exposure-not-run", "report-live-canvas-not-run"],
      "must_not": ["claim-connector-available", "claim-live-canvas-quality-passed"]
    }
  ]
}
