{
  "schema_version": "design-quality-contract-v1",
  "cases": [
    {
      "id": "auto-layout-uses-semantic-relationships",
      "target": "figma",
      "scenario": "세로 form 안에 label, input, help text와 action row가 있다.",
      "expected": ["structural-auto-layout", "semantic-layer-names", "content-driven-spacing"],
      "must_not": ["absolute-position-all-children", "auto-layout-every-decorative-layer"]
    },
    {
      "id": "fill-requires-auto-layout-parent",
      "target": "figma",
      "scenario": "child가 아직 일반 frame 아래에 있을 때 horizontal FILL을 요청한다.",
      "expected": ["append-to-auto-layout-parent-before-fill", "verify-axis-sizing"],
      "must_not": ["set-invalid-fill-and-continue"]
    },
    {
      "id": "responsive-content-extremes",
      "target": "figma",
      "scenario": "카드 목록이 0개, 1개, 20개이고 제목은 짧은 영어와 긴 일본어 번역을 가진다.",
      "expected": ["test-zero-one-many", "test-short-long-localized-copy", "test-narrow-wide"],
      "must_not": ["validate-default-content-only"]
    },
    {
      "id": "absolute-position-has-scoped-exception",
      "target": "figma",
      "scenario": "카드 모서리에 겹치는 decorative badge가 있다.",
      "expected": ["allow-scoped-overlay-or-decoration", "preserve-structural-parent-layout"],
      "must_not": ["reject-all-absolute-positioning", "make-whole-card-absolute"]
    },
    {
      "id": "component-property-responsibilities",
      "target": "figma",
      "scenario": "버튼에 state, size, optional leading icon과 label text가 있다.",
      "expected": ["variant-for-state-and-size", "boolean-or-instance-swap-for-icon", "text-property-for-label"],
      "must_not": ["variant-for-every-label", "detach-instance-silently"]
    },
    {
      "id": "project-token-convention-wins",
      "target": "figma",
      "scenario": "프로젝트가 한 단계 semantic variable 체계를 사용하지만 외부 가이드는 3-tier token을 권한다.",
      "expected": ["reuse-project-convention", "propose-change-separately-if-needed"],
      "must_not": ["invent-three-tier-token-system"]
    },
    {
      "id": "icon-source-priority",
      "target": "figma",
      "scenario": "기존 library에 20px Search icon component가 있고 화면에는 검색 icon이 필요하다.",
      "expected": ["reuse-icon-component", "use-instance-swap-when-configurable", "preserve-semantic-color"],
      "must_not": ["emoji-icon", "redraw-with-lines", "guess-alternate-glyph"]
    },
    {
      "id": "missing-exact-icon-stops-substitution",
      "target": "figma",
      "scenario": "요청한 brand icon의 정확한 asset을 찾지 못했다.",
      "expected": ["request-or-locate-exact-asset", "report-blocked-scope"],
      "must_not": ["invent-brand-mark", "use-similar-icon-without-disclosure"]
    },
    {
      "id": "interaction-has-three-evidence-layers",
      "target": "figma",
      "scenario": "Save 클릭 후 validation, submitting, success와 error branch가 있다.",
      "expected": ["executable-reaction", "readable-annotation", "named-state-topology", "flow-starting-point", "back-or-recovery-path"],
      "must_not": ["visual-arrow-only", "annotation-only-pass"]
    },
    {
      "id": "interaction-readback-partial-success",
      "target": "figma",
      "scenario": "화면과 annotation은 생성됐지만 reaction destination readback이 실패했다.",
      "expected_status": "inconclusive",
      "expected": ["report-created-parts", "report-unverified-reaction", "retry-only-affected-scope"],
      "must_not": ["claim-prototype-passed", "recreate-whole-file"]
    },
    {
      "id": "overlapping-conflict-domain-writes-are-serialized",
      "target": "figma",
      "scenario": "두 writer가 같은 component set과 그 instance가 연결된 prototype graph를 동시에 수정하려 한다.",
      "expected": ["identify-component-and-prototype-conflict-domains", "serialize-or-stop-overlapping-writers", "reread-target-before-write"],
      "must_not": ["parallelize-because-targets-have-different-node-ids", "trust-stale-selection"]
    },
    {
      "id": "independent-page-writes-require-provider-proof",
      "target": "figma",
      "scenario": "같은 file의 서로 다른 page를 수정하며 shared component, variable, prototype 또는 selection dependency가 없다.",
      "expected": ["confirm-provider-allows-parallel-writes", "prove-no-shared-dependency", "reread-each-target-before-write"],
      "must_not": ["serialize-all-same-file-work-unconditionally", "parallelize-from-page-name-only"]
    },
    {
      "id": "malformed-figma-target-stops-before-write",
      "target": "figma",
      "scenario": "사용자가 제공한 node ID가 malformed이고 현재 selection도 비어 있다.",
      "expected_status": "blocked",
      "expected": ["report-invalid-target", "request-one-exact-target"],
      "must_not": ["mutate-current-page-guess", "scan-and-change-unrelated-frames"]
    },
    {
      "id": "conflicting-component-sources-remain-visible",
      "target": "figma",
      "scenario": "Code Connect component, published library와 local component가 같은 이름이지만 서로 다른 property 계약을 가진다.",
      "expected": ["compare-source-and-contract", "prefer-confirmed-project-source", "request-decision-if-meaningful-conflict-remains"],
      "must_not": ["choose-by-name-only", "detach-and-merge-silently"]
    },
    {
      "id": "handoff-includes-behavioral-boundaries",
      "target": "figma",
      "scenario": "최종 desktop 화면은 완성됐지만 empty, loading, error, narrow width와 keyboard behavior가 아직 전달되지 않았다.",
      "expected_status": "failed",
      "expected": ["report-missing-states", "report-responsive-gap", "report-accessibility-or-keyboard-gap", "recheck-consuming-screen-and-prototype-path"],
      "must_not": ["pass-from-final-screenshot-only", "mark-ready-for-dev-without-team-contract"]
    },
    {
      "id": "custom-font-capability-is-unavailable",
      "target": "figma",
      "scenario": "제품 지정 custom font가 필요하지만 현재 provider에는 font load capability가 없다.",
      "expected_status": "blocked",
      "expected": ["record-font-load-unavailable", "preserve-font-requirement", "scope-blocker-to-font-dependent-layout"],
      "must_not": ["silently-substitute-font", "claim-typography-passed"]
    },
    {
      "id": "paper-flex-and-fixed-lanes",
      "target": "paper",
      "scenario": "긴 제목과 icon, trailing action을 가진 반복 row를 작성한다.",
      "expected": ["flex-layout", "gap-and-padding", "fixed-icon-and-action-lanes", "fit-content-on-clipping"],
      "must_not": ["html-table", "css-grid-without-current-support", "use-margin-as-primary-row-structure-without-flex-or-readback"]
    },
    {
      "id": "paper-code-handoff-uses-structure",
      "target": "paper",
      "scenario": "Paper 화면을 production code로 옮길 근거를 수집한다.",
      "expected": ["read-exact-jsx", "read-computed-styles", "adapt-to-codebase-conventions", "use-screenshot-for-visual-verification-only"],
      "must_not": ["derive-code-from-screenshot-only"]
    },
    {
      "id": "paper-prototype-is-spec-only",
      "target": "paper",
      "scenario": "현재 MCP에 native reaction API가 없는데 modal interaction을 요청한다.",
      "expected_status": "not_run",
      "expected": ["create-or-propose-state-artboards", "record-trigger-result-condition-in-comments", "label-interaction-spec-only"],
      "must_not": ["claim-clickable-prototype"]
    },
    {
      "id": "paper-tool-failure-cleans-working-state",
      "target": "paper",
      "scenario": "두 번째 visual group 작성 중 tool failure가 발생했다.",
      "expected": ["preserve-successful-groups", "report-failed-group", "deduplicate-owning-artboard-ids", "finish-working-on-owning-artboards", "resume-from-readback"],
      "must_not": ["duplicate-successful-groups", "claim-complete"]
    },
    {
      "id": "paper-malformed-html-recovers-smallest-scope",
      "target": "paper",
      "scenario": "한 visual group의 malformed HTML 때문에 write가 거부됐지만 이전 group은 정상이다.",
      "expected_status": "failed",
      "expected": ["preserve-previous-groups", "correct-failing-group-only", "readback-after-retry", "finish-working-on-owning-artboards"],
      "must_not": ["rewrite-whole-artboard", "duplicate-previous-groups"]
    },
    {
      "id": "paper-cleanup-failure-remains-visible",
      "target": "paper",
      "scenario": "화면 수정과 readback은 성공했지만 owning artboard에 대한 finish_working_on_nodes 호출이 실패했다.",
      "expected_status": "inconclusive",
      "expected": ["preserve-successful-design-work", "report-cleanup-failure-separately", "report-possibly-stale-working-indicator"],
      "must_not": ["claim-cleanup-passed", "repeat-design-write"]
    }
  ]
}
