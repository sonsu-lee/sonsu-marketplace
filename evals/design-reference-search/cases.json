{
  "schema_version": "design-reference-search-behavior-v1",
  "cases": [
    {
      "id": "find-references-login-auto",
      "split": "calibration",
      "installed_plugins": ["design"],
      "prompt": "로그인 화면 레퍼런스를 몇 개 찾아서 출처와 함께 정리해 줘.",
      "fixture": {
        "providers": [{"name": "mobbin", "state": "qualified"}],
        "tool_returns": "mobbin search_screens가 로그인 화면 8개의 메타데이터와 AI용 저해상도 이미지를 반환한다. 두 결과는 같은 앱의 같은 화면이며 URL에 utm 파라미터만 다르다."
      },
      "expected": ["decompose-queries-by-layer", "qualify-provider-before-search", "inspect-images-before-describing", "deduplicate-normalized-locators", "lock-one-primary-reference", "record-borrow-and-do-not-borrow", "attribute-each-reference"],
      "must_not": ["describe-from-metadata-only", "fabricate-locator", "average-references"]
    },
    {
      "id": "find-references-dashboard-mood-auto",
      "split": "calibration",
      "installed_plugins": ["design"],
      "prompt": "차분한 분위기의 대시보드 레퍼런스를 모아서 컴포넌트 스타일까지 비교해 줘.",
      "fixture": {
        "providers": [{"name": "web", "state": "qualified"}],
        "tool_returns": "웹 검색 결과는 Dribbble 컨셉 시안 5개, 출시된 SaaS 대시보드 2개, Material 데이터 테이블 지침 1개다."
      },
      "expected": ["translate-mood-into-concrete-style-attributes", "separate-style-and-component-layers", "label-concept-source-kind", "include-cross-industry-example-for-exploration"],
      "must_not": ["use-vague-adjective-as-query", "cite-concept-as-usability-evidence"]
    },
    {
      "id": "find-references-explicit",
      "split": "held_out",
