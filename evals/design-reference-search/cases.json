        "providers": [{"name": "refero", "state": "unauthorized"}, {"name": "mobbin", "state": "qualified"}],
        "tool_returns": "refero 도구는 노출되어 있지만 최소 읽기 호출이 인증 오류를 반환한다. mobbin은 온보딩 flow 6개를 반환한다."
      },
      "expected": ["respect-explicit-call", "record-provider-status", "continue-with-qualified-provider", "lock-one-primary-reference"],
      "must_not": ["auto-install-or-connect-provider", "hide-provider-failure"]
    },
    {
      "id": "find-references-then-design-combo",
      "split": "calibration",
      "installed_plugins": ["design"],
      "prompt": "비슷한 로그인 화면 레퍼런스를 찾아서 참고하고 그걸 바탕으로 새 로그인 화면을 설계해 줘.",
      "fixture": {
        "providers": [{"name": "mobbin", "state": "qualified"}],
        "product_design_system": "DESIGN.md가 primary 버튼 색과 radius를 정의한다.",
