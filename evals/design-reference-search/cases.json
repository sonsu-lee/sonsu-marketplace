      "expected": ["select-design-interface", "apply-reference-search-contract-within-design", "record-extensions-references-in-contract", "keep-product-design-system-over-reference"],
      "must_not": ["require-separate-find-references-call", "copy-reference-values-as-product-facts"]
    },
    {
      "id": "find-references-redesign-user-supplied",
      "split": "calibration",
