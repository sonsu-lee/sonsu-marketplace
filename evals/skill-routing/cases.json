      "must_not_select": ["quality-engineering:domain-shaped-code", "quality-engineering:simplify-code"]
    },
    {
      "id": "debugging-does-not-trigger-quality-review",
      "installed_plugins": ["engineering", "quality-engineering"],
      "prompt": "실패하는 통합 테스트의 root cause를 찾아서 디버깅하고 수정해줘.",
      "expected_plugins": ["engineering"],
      "must_not_select": ["quality-engineering:review-failure-modes", "quality-engineering:review-quality"]
    },
    {
      "id": "architecture-decision-does-not-trigger-quality",
      "installed_plugins": ["engineering", "quality-engineering"],
      "prompt": "이벤트 버스와 직접 호출 중 아직 결론이 나지 않은 아키텍처 선택을 비교해 결정 자료를 만들어줘.",
      "must_not_select": ["quality-engineering:domain-shaped-code", "quality-engineering:review-quality"]
    },
    {
      "id": "domain-glossary-does-not-trigger-domain-shaped-code",
