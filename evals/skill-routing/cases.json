      "must_not_select": ["quality-engineering:review-failure-modes", "quality-engineering:review-quality"]
    },
    {
      "id": "long-file-is-not-a-maintainability-finding-by-itself",
      "installed_plugins": ["quality-engineering"],
      "prompt": "이 1,200줄 파일을 유지보수성 관점에서 리뷰해줘. 길다는 이유만으로 분할하지 말고 실제 reader load와 변경 이유를 확인해.",
      "expected_sequence": ["quality-engineering:review-maintainability"],
      "must_not_assume_finding_from_line_count": true
