      "prompt": "이 repository의 도메인 용어를 조사해서 CONTEXT.md를 작성해줘.",
      "must_not_select": ["quality-engineering:domain-shaped-code"]
    },
    {
      "id": "git-delivery-does-not-trigger-quality",
      "installed_plugins": ["quality-engineering", "workflow"],
      "prompt": "현재 변경을 커밋하고 push한 뒤 PR을 만들어줘.",
      "expected_sequence": ["workflow:git-workflow", "workflow:to-pr"],
      "must_not_select": ["quality-engineering:review-quality"]
