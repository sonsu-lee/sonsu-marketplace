{
  "schema_version": "design-skill-routing-v1",
  "cases": [
    {
      "id": "clickable-product-flow-routes-to-figma-design",
      "installed_plugins": ["design", "figma", "drawio"],
      "prompt": "결제 화면에서 Pay 버튼을 누르면 확인 modal이 뜨고 성공하면 주문 상세로 이동하는 클릭 가능한 Figma prototype을 만들어 줘.",
      "expected_sequence": ["design:figma-product-design", "figma:figma-use", "figma:figma-generate-design", "design:figma-prototype-flow"],
      "expected_artifact": "figma-design",
      "must_create_executable_reactions": true,
      "must_not_select": ["drawio:drawio", "figma:figma-generate-diagram"]
    },
    {
      "id": "figma-audit-remains-read-only",
      "installed_plugins": ["design", "figma"],
      "prompt": "현재 선택한 Figma checkout frame의 Auto Layout, component 재사용, icon과 끊긴 prototype 동선을 수정하지 말고 검토해 줘.",
      "expected_sequence": ["design:figma-design-audit", "figma:figma-use"],
      "expected_mode": "read-only",
      "must_not_mutate": true,
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow"]
    },
    {
      "id": "aws-architecture-routes-to-drawio",
      "installed_plugins": ["design", "figma", "drawio"],
      "prompt": "AWS VPC, public/private subnet, ALB, ECS와 RDS 구조도를 그려 줘.",
      "expected_sequence": ["drawio:drawio"],
      "expected_artifact": "drawio",
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow", "figma:figma-generate-diagram"]
    },
    {
      "id": "workshop-journey-routes-to-figjam",
      "installed_plugins": ["design", "figma", "drawio"],
      "prompt": "팀 워크숍에서 쓸 신규 사용자 onboarding journey를 sticky note와 branch로 FigJam에 정리해 줘.",
      "expected_sequence": ["figma:figma-use-figjam"],
      "expected_artifact": "figjam",
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow", "drawio:drawio"]
    },
    {
      "id": "paper-code-roundtrip-routes-to-paper",
      "installed_plugins": ["design", "figma"],
      "available_tools": ["paper-mcp"],
      "prompt": "이 React dashboard를 Paper에서 flex 기반으로 탐색하고 수정한 다음 정확한 JSX와 computed style을 확인해 줘.",
      "expected_sequence": ["design:paper-product-design"],
      "expected_artifact": "paper-design",
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow", "drawio:drawio"]
    },
    {
      "id": "generic-user-flow-asks-only-when-artifact-ambiguous",
      "installed_plugins": ["design", "figma", "drawio"],
      "prompt": "가입 user flow를 그려 줘.",
      "expected_action": "clarify-artifact-intent",
      "allowed_choices": ["figma-design", "figjam", "drawio", "paper-design"],
      "must_not_mutate": true
    },
    {
      "id": "figma-wireframe-is-not-hijacked-by-drawio",
      "installed_plugins": ["design", "figma", "drawio"],
      "prompt": "Figma 안에 모바일 예약 화면 wireframe과 화면 간 클릭 동선을 만들어 줘.",
      "expected_sequence": ["design:figma-product-design", "figma:figma-use", "figma:figma-generate-design", "design:figma-prototype-flow"],
      "expected_artifact": "figma-design",
      "must_not_select": ["drawio:drawio"]
    },
    {
      "id": "design-to-code-remains-official-figma-responsibility",
      "installed_plugins": ["design", "figma"],
      "prompt": "이 Figma selection을 기존 React 프로젝트의 component와 token을 재사용해서 구현해 줘.",
      "expected_sequence": ["figma:figma-design-to-code"],
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow", "design:figma-design-audit"]
    },
    {
      "id": "library-generation-remains-official-figma-responsibility",
      "installed_plugins": ["design", "figma"],
      "prompt": "이 코드베이스를 바탕으로 Figma design system library 전체를 만들어 줘.",
      "expected_sequence": ["figma:figma-generate-library"],
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow"]
    },
    {
      "id": "screen-creation-composes-official-and-local-skills",
      "installed_plugins": ["design", "figma"],
      "prompt": "Figma에 responsive pricing 화면을 만들고 Auto Layout과 긴 일본어 copy까지 검증해 줘.",
      "expected_sequence": ["design:figma-product-design", "figma:figma-use", "figma:figma-generate-design"],
      "expected_artifact": "figma-design",
      "must_not_select": ["design:figma-prototype-flow", "figma:figma-generate-library"]
    },
    {
      "id": "single-component-authoring-remains-official-library-responsibility",
      "installed_plugins": ["design", "figma"],
      "prompt": "Figma에 Button component 하나를 variants와 variable binding까지 갖춰 만들어 줘.",
      "expected_sequence": ["figma:figma-generate-library", "figma:figma-use"],
      "expected_artifact": "figma-design-library",
      "must_not_select": ["design:figma-product-design", "design:figma-prototype-flow"]
    },
    {
      "id": "missing-figma-write-capability-falls-back-to-spec",
      "installed_plugins": ["design"],
      "available_tools": [],
      "prompt": "Figma에 settings 화면을 만들고 저장 버튼을 success 화면에 연결해 줘.",
      "expected_sequence": ["design:figma-product-design", "design:figma-prototype-flow"],
      "expected_mode": "advisory-spec",
      "expected_status": "not_run",
      "must_not_claim_canvas_mutation": true,
      "must_not_assume_plugin_dependency": true
    },
    {
      "id": "missing-paper-capability-does-not-switch-products",
      "installed_plugins": ["design", "figma", "drawio"],
      "available_tools": [],
      "prompt": "Paper Design에서 이 pricing page를 수정해 줘.",
      "expected_sequence": ["design:paper-product-design"],
      "expected_status": "blocked",
      "must_not_fallback_to": ["figma-design", "drawio"],
      "must_not_claim_mutation": true
    },
    {
      "id": "paper-prototype-request-reports-capability-gap",
      "installed_plugins": ["design"],
      "available_tools": ["paper-mcp-without-prototype-api"],
      "prompt": "Paper에서 버튼을 클릭하면 modal이 실제로 열리는 prototype을 만들어 줘.",
      "expected_sequence": ["design:paper-product-design"],
      "expected_interaction_result": "spec-only",
      "must_offer_state_artboards_and-comments": true,
      "must_not_claim_clickable_prototype": true,
      "must_not_select": ["design:figma-prototype-flow"]
    },
    {
      "id": "existing-figma-flow-edit-routes-to-prototype-skill",
      "installed_plugins": ["design", "figma"],
      "prompt": "기존 Figma checkout 화면은 그대로 두고 Pay 버튼의 modal, Confirm, success/error 연결만 고쳐 줘.",
      "expected_sequence": ["design:figma-prototype-flow", "figma:figma-use"],
      "expected_artifact": "figma-design",
      "must_preserve_visual_structure": true,
      "must_not_select": ["design:figma-product-design", "design:figma-design-audit"]
    },
    {
      "id": "existing-flow-verification-without-mutation-routes-to-audit",
      "installed_plugins": ["design", "figma"],
      "prompt": "기존 checkout prototype이 starting point부터 success와 error recovery까지 실제로 동작하는지 확인해 줘.",
      "expected_sequence": ["design:figma-design-audit", "figma:figma-use"],
      "expected_mode": "read-only",
      "must_not_mutate": true,
      "must_not_select": ["design:figma-prototype-flow", "design:figma-product-design"]
    }
  ]
}
