      "installed_plugins": [
        "interface-design",
        "operations-ui",
        "figma-workflow",
        "engineering"
      ],
      "prompt": "운영자가 주문을 필터링하고 선택해 일괄 보류하는 화면을 제안해 줘. 구현은 하지 마.",
      "expected": {
        "select": "operations-ui:design-operations-ui",
