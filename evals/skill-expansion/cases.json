        "claim_complete": false
      }
    },
    {
      "id": "pr-duplicate-root-cause",
      "installed_plugins": [
        "quality-engineering"
      ],
      "prompt": "$review-pr 이미 완료된 리뷰 결과를 통합해 줘. 같은 고정 base/head를 검토한 Luna 5명 중 3명이 동일한 무권한 수정 경로를 각각 보고했고, Astra 1명도 같은 원인을 다른 표현으로 보고했어. 한 Luna는 별도의 재시도 중복 결제를 발견했어. 두 문제 모두 재현 근거가 확인됐어.",
      "expected": {
        "unique_findings": 2,
        "majority_vote": false,
        "restart_reviews": false
