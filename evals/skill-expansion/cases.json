    {
      "id": "pr-state-stale-like",
      "installed_plugins": [
        "workflow"
      ],
      "prompt": "$inspect-prs 현재 관찰을 토대로 PR 상태를 보고해 줘.",
      "expected": {
        "must_not_claim_approved_head": true,
        "must_not_claim_ci_pass": true,
        "must_report_partial": true
      },
      "fixture": {
        "repository": "example/project",
        "pr": 12,
        "head": "new-head",
        "reaction": {
          "actor": "chatgpt-codex-connector[bot]",
          "content": "+1",
          "before_head_change": true
        },
        "reviews": [
          {
            "commit": "old-head",
            "state": "APPROVED"
          }
        ],
        "ci": "pending",
        "threads_page_2": "timeout"
      }
    },
    {
      "id": "repair-unknown-push",
      "installed_plugins": [
        "workflow"
      ],
      "prompt": "$repair-pr 아래 진행 상황에서 다음 행동과 실제 결과를 정리해 줘.",
      "expected": {
        "must_not_resolve": true,
        "must_read_remote_before_retry": true,
        "remote_result": "unknown"
      },
      "fixture": {
        "pr": 12,
        "local_tests": "passed",
        "commit": "abc",
        "authorized": [
          "commit",
          "push",
          "reply",
          "resolve"
        ],
        "push_response": "timeout",
        "remote_readback": "unavailable",
        "thread": "unresolved",
        "ci": "unknown"
      }
    },
