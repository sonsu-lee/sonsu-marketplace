      "stage": "task-execution",
      "prompt": "Task 2 구현 뒤 회귀 테스트가 실패했다. 계획과 Task 1 검증은 통과했다. 다음 행동과 gate 상태를 기록해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "required regression test exits 1"
      },
      "expected": {
        "status": "failed",
        "return_target": "task-implementation-or-systematic-debugging",
        "retry_requires_changed_input": true,
        "must_preserve_last_green_checkpoint": true
      },
      "must_not": [
        "restart-whole-workflow",
        "rewrite-plan-without-plan-defect",
        "mark-task-complete"
      ]
    },
    {
