{
  "schema_version": "engineering-quality-gates-v3",
  "cases": [
    {
      "id": "mechanical-metadata-change-uses-checks-only",
      "stage": "policy-selection",
      "prompt": "공개 계약이나 동작을 바꾸지 않는 플러그인 설명 오탈자를 고쳤고, JSON parser와 loader 확인이 가능하다. 필요한 quality policy와 완료 근거를 정해줘.",
      "event": {
        "risk_evidence": [
          "no behavior or public-contract change",
          "declared parser and loader checks cover the changed metadata"
        ],
        "artifact": "current plugin manifest revision"
      },
      "expected": {
        "policy": "checks",
        "required_evidence": [
          "declared consumer checks on the current artifact"
        ],
        "red_team": "not_applicable"
      },
      "must_not": [
        "require-independent-review-only-because-a-file-changed",
        "treat-a-zero-exit-code-as-semantic-proof"
      ]
    },
    {
      "id": "behavior-change-uses-independent-review",
      "stage": "policy-selection",
      "prompt": "기존 API의 정상 동작은 유지하지만 입력 검증과 오류 응답을 바꾸는 구현을 완료했다. 필요한 policy와 review 근거를 정해줘.",
      "event": {
        "risk_evidence": [
          "behavior changes",
          "callers can observe error-response differences"
        ],
        "artifact": "implementation workspace snapshot"
      },
      "expected": {
        "policy": "independent",
        "required_evidence": [
          "relevant checks",
          "Luna xhigh 5 independent fresh-context reviews",
          "coordinator validation for each finding"
        ],
        "red_team": "not_applicable-unless-a-higher-risk-boundary-is-confirmed"
      },
      "must_not": [
        "classify-by-plan-existence",
        "count-findings-or-majority-as-a-pass-rule"
      ]
    },
    {
      "id": "recovery-boundary-uses-red-team",
      "stage": "policy-selection",
      "prompt": "데이터 복구와 권한 상태 전이를 함께 바꾸는 migration을 완료했다. 이 변경에 필요한 policy와 completion gate를 정해줘.",
      "event": {
        "risk_evidence": [
          "authorization boundary",
          "recovery boundary",
          "data integrity risk"
        ],
        "artifact": "integration workspace snapshot"
      },
      "expected": {
        "policy": "red-team",
        "required_evidence": [
          "independent policy evidence",
          "fresh-context Astra high red-team",
          "survives_challenge verdict on the frozen current bundle"
        ]
      },
      "must_not": [
        "skip-independent-review",
        "replace-red-team-with-plan-review",
        "downgrade-risk-to-close-the-gate"
      ]
    },
    {
      "id": "resume-retains-rounds-and-reassesses-current-risk",
      "stage": "resume",
      "prompt": "컴팩션 뒤 작업을 재개한다. 이전 기록에는 task ID, 2개의 review round, checks와 finding-to-fix 근거가 있다. 현재 workspace가 바뀌었는지와 다음 행동을 판정해줘.",
      "event": {
        "prior_task_id": "migration-recovery",
        "prior_review_rounds": 2,
        "resume_reason": "compaction",
        "current_artifact_comparison": "required before reusing evidence"
      },
      "expected": {
        "retain": [
          "task ID",
          "history",
          "consumed review rounds"
        ],
        "required_next_action": "compare current source, contracts, and prior evidence; reopen only affected policy evidence",
        "resume_is": "not-an-automatic-disqualification"
      },
      "must_not": [
        "reset-round-budget",
        "replay-a-prior-pass-without-current-artifact-check",
        "route-to-a-deleted-fast-path-state-machine"
      ]
    },
    {
      "id": "focused-fix-uses-one-luna-rereview",
      "stage": "independent-review-follow-up",
      "prompt": "일반 전체 리뷰 뒤 한 finding을 고쳤다. 변경은 한 validation branch에 국한되고 영향받은 소비자와 새 회귀 검사가 확인됐다. 필요한 rereview를 정해줘.",
      "event": {
        "prior_whole_review": "current and valid outside the changed branch",
        "delta": "single validation branch",
        "impact": "bounded with supporting checks"
      },
      "expected": {
        "required_evidence": [
          "prior whole-review scope",
          "current delta and impact rationale",
          "new focused checks",
          "Luna xhigh 1 focused rereview"
        ],
        "whole_review": "not_required"
      },
      "must_not": [
        "run-five-reviewers-for-a-proven-local-fix",
        "discard-valid-unaffected-evidence"
      ]
    },
    {
      "id": "unknown-impact-reopens-five-review-round",
      "stage": "independent-review-follow-up",
      "prompt": "리뷰 finding을 고치면서 공개 계약과 dependency edge가 바뀌었다. 영향받은 소비자를 확정하지 못했다. 필요한 rereview를 정해줘.",
      "event": {
        "material_boundary_change": true,
        "impact": "unknown"
      },
      "expected": {
        "required_evidence": [
          "reopened current workspace snapshot",
          "Luna xhigh 5 fresh-context independent reviews"
        ],
        "return_target": "affected-design-plan-or-implementation-owner"
      },
      "must_not": [
        "reuse-prior-whole-review-as-current-proof",
        "substitute-one-focused-review-for-the-reopened-round"
      ]
    },
    {
      "id": "five-reviewers-are-one-round",
      "stage": "independent-review",
      "prompt": "일반 전체 리뷰에 Luna xhigh reviewer 5명을 새 문맥으로 배정했다. 회차와 pass 조건을 기록해줘.",
      "event": {
        "reviewers": 5,
        "same_frozen_artifact": true,
        "fresh_context_per_reviewer": true
      },
      "expected": {
        "rounds_consumed": 1,
        "pass_requires": "all required review completions plus coordinator finding validation",
        "finding_rule": "one evidenced valid finding is actionable"
      },
      "must_not": [
        "count-each-reviewer-as-a-fix-round",
        "use-majority-vote",
        "pass-with-an-incomplete-required-reviewer"
      ]
    },
    {
      "id": "review-single-finding-is-actionable",
      "stage": "independent-review",
      "prompt": "5개 독립 리뷰 중 1개만 재현 가능한 authorization bypass를 지적했고 나머지는 finding이 없다. 다음 gate 상태와 반환 대상을 정해줘.",
      "event": {
        "completed_reviews": 5,
        "valid_findings": 1,
        "finding_evidence": "reachable request path and contract violation"
      },
      "expected": {
        "status": "failed",
        "return_target": "closest-implementation-or-design-owner",
        "must_preserve": "all original review outputs and coordinator validation"
      },
      "must_not": [
        "pass-by-four-to-one-majority",
        "discard-the-single-finding-without-evidence-based-rebuttal"
      ]
    },
    {
      "id": "review-all-5-required",
      "stage": "independent-review",
      "prompt": "일반 전체 리뷰의 5개 중 4개만 완료됐다. finding은 아직 없다. 완료 상태를 판정해줘.",
      "event": {
        "completed_reviews": 4,
        "required_reviews": 5
      },
      "expected": {
        "status": "not_run-or-incomplete",
        "return_target": "independent-review-completion"
      },
      "must_not": [
        "mark-passed",
        "treat-missing-output-as-no-finding"
      ]
    },
    {
      "id": "red-team-follows-risk-not-plan-existence",
      "stage": "completion-policy",
      "prompt": "여러 단계 계획으로 구현했지만 변경은 private formatting migration이고 현재 위험은 checks 정책이다. red-team 필요 여부를 판정해줘.",
      "event": {
        "has_plan": true,
        "confirmed_risk_policy": "checks",
        "high_risk_boundary": false
      },
      "expected": {
        "red_team": "not_applicable",
        "completion_requires": "current checks policy evidence"
      },
      "must_not": [
        "require-red-team-only-because-the-work-had-a-plan",
        "infer-red-team-from-a-deleted-fast-path-classification"
      ]
    },
    {
      "id": "root-allocation-keeps-reviewers-independent",
      "stage": "review-dispatch",
      "prompt": "일반 전체 review를 시작한다. root, reviewer와 implementer의 배정·수정 권한을 정해줘.",
      "event": {
        "policy": "independent",
        "artifact_is_frozen": true,
        "required_reviewers": 5
      },
      "expected": {
        "root_owns": [
          "reviewer allocation",
          "result collection",
          "finding validation and routing"
        ],
        "reviewer_owns": "direct review of the assigned frozen input",
        "implementer_owns": "only an approved returned fix"
      },
      "must_not": [
        "let-a-reviewer-spawn-another-reviewer",
        "let-a-review-request-authorize-a-fix",
        "feed-one-initial-reviewer-the-others-findings-before-their-review"
      ]
    },
    {
      "id": "red-team-freezes-current-workspace-and-provenance",
      "stage": "red-team-preparation",
      "prompt": "고위험 변경의 independent gate가 끝났다. Astra red-team에 넘길 입력을 고정해줘.",
      "event": {
        "confirmed_risk_policy": "red-team",
        "independent_evidence": "complete",
        "workspace_revision": "current"
      },
      "expected": {
        "bundle_contains": [
          "whole current change",
          "original goal",
          "requirements and design",
          "plan and mapping when present",
          "verification report",
          "outcomes and constraints",
          "finding-to-fix provenance"
        ],
        "reviewer": "fresh-context Astra high",
        "accepted_verdict": "survives_challenge"
      },
      "must_not": [
        "supply-required-evidence-from-mutable-source-paths-after-freeze",
        "treat-accepted_risk-as-survives_challenge"
      ]
    },
    {
      "id": "workspace-and-document-snapshots-have-different-roles",
      "stage": "artifact-identification",
      "prompt": "설계 문서, 구현 workspace, 최종 통합 workspace를 검토한다. 각 gate가 고정해야 할 artifact를 정해줘.",
      "event": {
        "artifacts": [
          "approved design document",
          "implementation workspace",
          "integration workspace"
        ]
      },
      "expected": {
        "snapshots": {
          "design_or_plan": "fixed document package",
          "implementation": "isolated full workspace snapshot",
          "integration": "final full workspace snapshot"
        }
      },
      "must_not": [
        "use-a-diff-alone-as-the-implementation-or-integration-snapshot",
        "invalidate-an-unchanged-design-document-only-because-code-changed"
      ]
    },
    {
      "id": "five-round-cap-preserves-current-evidence-without-fixed-allocation",
      "stage": "review-follow-up",
      "prompt": "같은 high-risk gate가 이미 5개 review round를 소비했고 유효한 finding이 남아 있다. 담당자 변경이나 3+2 배정 규칙 없이 다음 상태를 정해줘.",
      "event": {
        "consumed_rounds": 5,
        "valid_required_finding": true,
        "human_accepted_risk": false
      },
      "expected": {
        "automatic_retry": "stopped",
        "status": "failed-or-decision_required",
        "must_preserve": [
          "current artifact",
          "round count",
          "finding evidence",
          "return target"
        ]
      },
      "must_not": [
        "reset-rounds-on-resume-or-handoff",
        "auto-pass",
        "require-the-deleted-3-plus-2-implementer-allocation"
      ]
    },
    {
      "id": "accepted-risk-remains-separate-from-passed",
      "stage": "completion",
      "prompt": "지명된 사람이 정확한 current revision의 남은 위험을 명시적으로 수용했다. completion 상태를 기록해줘.",
      "event": {
        "human_accepted_risk": true,
        "accepted_revision": "current",
        "risk_description": "documented"
      },
      "expected": {
        "status": "accepted_risk",
        "report_separates": [
          "accepted risk",
          "passed checks",
          "not_run or unresolved required evidence"
        ]
      },
      "must_not": [
        "rename-accepted-risk-to-passed",
        "use-agent-budget-exhaustion-as-human-acceptance"
      ]
    }
  ]
}
