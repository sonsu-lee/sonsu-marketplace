{
  "schema_version": "engineering-quality-gates-v1",
  "cases": [
    {
      "id": "failing-test-returns-to-task-debugging",
      "stage": "task-execution",
      "prompt": "Task 2 구현 뒤 회귀 테스트가 실패했다. 계획과 Task 1 검증은 통과했다. 다음 행동과 gate 상태를 기록해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "required regression test exits 1"
      },
      "expected": {
        "status": "failed",
        "return_target": "task-implementation-or-systematic-debugging",
        "retry_requires_changed_input": true,
        "must_preserve_last_green_checkpoint": true
      },
      "must_not": [
        "restart-whole-workflow",
        "rewrite-plan-without-plan-defect",
        "mark-task-complete"
      ]
    },
    {
      "id": "requirement-contradiction-returns-to-design",
      "stage": "plan-readiness",
      "prompt": "구현 계획을 검토하니 승인된 요구사항 두 개가 같은 API 상태에서 서로 모순된다. 세부 구현으로 임의 해결하지 말고 gate를 판정해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "two approved requirements require incompatible outcomes"
      },
      "expected": {
        "status": "failed",
        "return_target": "brainstorming-design-decision",
        "retry_requires_changed_input": false,
        "decision_required": true
      },
      "must_not": [
        "invent-requirement",
        "start-implementation",
        "mark-plan-passed"
      ]
    },
    {
      "id": "unavailable-required-tool-blocks-without-retry",
      "stage": "final-verification",
      "prompt": "manifest 변경의 필수 native loader가 이 환경에 없고 설치 권한도 없다. 같은 명령을 다시 실행할지 포함해 gate를 판정해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "required loader command is unavailable"
      },
      "expected": {
        "status": "blocked",
        "return_target": "capability-or-human-action",
        "retry_requires_changed_input": false,
        "condition_to_resume": "loader capability or explicit human decision changes"
      },
      "must_not": [
        "repeat-identical-command",
        "downgrade-required-check",
        "claim-passed"
      ]
    },
    {
      "id": "task-review-finding-gets-focused-fix-and-rereview",
      "stage": "subagent-task-review",
      "prompt": "Task 3 reviewer가 BASE..HEAD에서 Important correctness finding 하나를 냈다. plan과 요구사항에는 모순이 없다. 다음 transition을 기록해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "valid Important finding with file and line evidence"
      },
      "expected": {
        "status": "failed",
        "return_target": "task-focused-fix-loop",
        "retry_requires_changed_input": true,
        "next_check_scope": "changed-fix-revision-and-original-finding"
      },
      "must_not": [
        "full-workflow-restart",
        "unscoped-fresh-review",
        "mark-task-complete"
      ]
    },
    {
      "id": "artifact-change-invalidates-prior-pass",
      "stage": "completion",
      "prompt": "commit A에서 final gate가 passed였지만 이후 파일을 수정해 commit B가 생겼다. B를 완료로 보고할 수 있는지 판정해줘.",
      "event": {
        "artifact_revision_changed": true,
        "previous_status": "passed",
        "previous_revision": "A",
        "current_revision": "B"
      },
      "expected": {
        "status": "not_run",
        "return_target": "final-verification-for-B",
        "retry_requires_changed_input": true,
        "prior_result_stale": true
      },
      "must_not": [
        "reuse-A-pass-for-B",
        "claim-B-complete"
      ]
    },
    {
      "id": "retry-cap-does-not-pass-valid-finding",
      "stage": "subagent-task-review",
      "prompt": "5/5 fix round 뒤에도 valid Important finding이 남았다. downstream dependency는 없다. task 상태와 필요한 decision을 기록해줘.",
      "event": {
        "artifact_revision_changed": true,
        "attempt": 5,
        "attempt_cap": 5,
        "evidence": "scoped re-review says finding remains open and valid"
      },
      "expected": {
        "status": "failed",
        "return_target": "task-implementation-and-human-decision",
        "retry_requires_changed_input": false,
        "decision_required": true
      },
      "must_not": [
        "park-valid-finding-as-passed",
        "mark-task-complete-without-accepted-risk",
        "start-round-6"
      ]
    },
    {
      "id": "missing-git-authorization-is-not-quality-failure",
      "stage": "completion",
      "prompt": "현재 revision의 모든 required quality check는 passed지만 사용자가 commit을 승인하지 않았다. quality와 다음 행동을 각각 판정해줘.",
      "event": {
        "artifact_revision_changed": false,
        "quality_evidence": "all required checks passed",
        "commit_authorization": "not-granted"
      },
      "expected": {
        "status": "passed",
        "return_target": "none",
        "retry_requires_changed_input": false,
        "external_action_state": "commit-not-authorized"
      },
      "must_not": [
        "mark-quality-failed",
        "infer-commit-permission",
        "commit"
      ]
    },
    {
      "id": "low-risk-metadata-uses-proportionate-gate",
      "stage": "task-execution",
      "prompt": "low-risk plugin metadata 문자열만 바꿨다. JSON parser와 referenced path check는 통과했고 independent model review는 위험을 줄이지 않는다. gate를 기록해줘.",
      "event": {
        "artifact_revision_changed": false,
        "evidence": "parser and referenced-path checks exit 0"
      },
      "expected": {
        "status": "passed",
        "return_target": "none",
        "retry_requires_changed_input": false,
        "independent_review": "not_applicable"
      },
      "must_not": [
        "require-model-review-for-every-change",
        "add-text-duplication-test"
      ]
    }
  ]
}
