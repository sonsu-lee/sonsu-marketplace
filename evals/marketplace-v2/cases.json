{
  "schema_version": "marketplace-v2-cases-v1",
  "profiles": {
    "engineering": {
      "required_skills": [
        "review",
        "review-failure-modes",
        "review-maintainability",
        "test-driven-development",
        "execute-plan"
      ]
    }
  },
  "fixtures": {
    "review-service": {
      "description": "Webhook trust boundary, internal typed flow, provider cleanup, and historical docs snapshot in one reviewable change.",
      "path": "fixtures/review-service"
    },
    "workflow-pack": {
      "description": "Small deterministic and behavior-changing implementation tasks plus provider routing notes.",
      "path": "fixtures/workflow-pack"
    }
  },
  "cases": [
    {
      "id": "review-benchmark",
      "fixture": "review-service",
      "profile": "engineering",
      "kind": "review",
      "sandbox": "read-only",
      "benchmark": true,
      "prompt": "CHANGE.md에 적힌 현재 변경 전체를 일반 코드 리뷰해줘. 관련 호출자, 테스트, 계약과 문서를 읽고, 파일은 수정하지 마. finding은 정확한 path:line, 발생 조건, 영향, 최소 수정 방향으로 보고하고 실행하지 않은 검증은 구분해줘.",
      "expected": {
        "skill_route": "engineering:review",
        "defects": {
          "external-payload-cast": "src/webhook.ts의 unknown payload가 runtime validation 없이 TrustedWebhook으로 단언되어 잘못된 kind와 빈 accountId가 실제 경계 안으로 들어온다.",
          "provider-session-leak": "src/provider.ts는 provider.execute가 throw하면 provider.close에 도달하지 않아 session을 누수한다."
        },
        "must_not_report": {
          "duplicate-internal-guard": "src/dispatch.ts에서 이미 좁혀진 TrustedWebhook을 다시 runtime validation하라는 요구",
          "snapshot-invalidated": "현재 v3 코드가 docs/provider-api-v2-snapshot.md를 자동으로 stale 또는 수정 대상으로 만든다는 주장",
          "invented-production-incident": "fixture가 제공하지 않은 운영 사고를 관찰했다는 주장"
        },
        "unnecessary_changes": [
          "provider factory나 strategy 계층 추가",
          "internal dispatch validation 중복",
          "historical snapshot 갱신"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 1
      }
    },
    {
      "id": "general-review-default",
      "fixture": "review-service",
      "profile": "engineering",
      "kind": "routing",
      "sandbox": "read-only",
      "benchmark": false,
      "prompt": "CHANGE.md의 변경을 일반 코드 리뷰해줘. 수정은 하지 마.",
      "expected": {
        "skill_route": "engineering:review",
        "review_mode": "five-fresh-reviewers",
        "reviewer_count": 5,
        "reviewer_model": "gpt-5.6-luna",
        "reviewer_effort": "xhigh",
        "must_not": [
          "review lens마다 같은 원인을 중복 finding으로 보고",
          "리뷰어가 다시 하위 리뷰어를 생성"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 5
      }
    },
    {
      "id": "focused-failure-lens",
      "fixture": "review-service",
      "profile": "engineering",
      "kind": "routing",
      "sandbox": "read-only",
      "benchmark": false,
      "prompt": "src/provider.ts 변경의 failure modes만 집중 리뷰해줘. 파일은 수정하지 마.",
      "expected": {
        "skill_route": "engineering:review-failure-modes",
        "review_mode": "single-fresh-delegated-reviewer",
        "reviewer_count": 1,
        "reviewer_model": "gpt-5.6-luna",
        "reviewer_effort": "xhigh",
        "must_find": [
          "provider-session-leak"
        ],
        "must_not": [
          "일반 리뷰 5인 team 생성",
          "관련 없는 maintainability finding 추가"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 1
      }
    },
    {
      "id": "mechanical-deterministic",
      "fixture": "workflow-pack",
      "profile": "engineering",
      "kind": "implementation",
      "sandbox": "workspace-write",
      "benchmark": false,
      "prompt": "config.json의 키를 알파벳순으로 정렬하고 JSON parse로 확인해줘. 이 fixture 안의 config.json만 수정해.",
      "expected": {
        "review_mode": "none",
        "changed_paths": [
          "config.json"
        ],
        "must_observe": [
          "결정론적 JSON parse 검사"
        ],
        "must_not": [
          "전체 계획 DAG",
          "독립 일반 리뷰",
          "red-team",
          "subagent 생성"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 0
      }
    },
    {
      "id": "behavior-change-gates",
      "fixture": "workflow-pack",
      "profile": "engineering",
      "kind": "implementation",
      "sandbox": "workspace-write",
      "benchmark": false,
      "prompt": "CONTRACT.md에 맞게 src/retry.js의 normalizeRetries 동작을 구현하고 tests/retry.test.js로 보호해줘. fixture 안에서 구현, 필요한 검증, 완료 게이트까지 수행해.",
      "expected": {
        "must_observe": [
          "동작 계약과 구현 흐름 대응",
          "결함 상태를 검출하는 테스트 또는 동등한 재현",
          "현재 변경에 대한 결정론적 검증",
          "독립 일반 리뷰를 fresh reviewer 5명으로 수행"
        ],
        "must_not": [
          "테스트 통과만으로 전체 게이트 통과 주장",
          "계획이 있다는 이유만으로 fresh red-team을 필수화",
          "선택적 Stop observer의 무응답을 review 완료 증거로 사용"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 5
      }
    },
    {
      "id": "docs-snapshot-boundary",
      "fixture": "review-service",
      "profile": "engineering",
      "kind": "review",
      "sandbox": "read-only",
      "benchmark": false,
      "prompt": "유지보수성 관점에서 src/client.ts와 docs/provider-api-v2-snapshot.md의 관계만 집중 리뷰해줘. 현재 코드 변경이 문서 수정을 요구하는지 판단하고 수정은 하지 마.",
      "expected": {
        "skill_route": "engineering:review-maintainability",
        "review_mode": "single-fresh-delegated-reviewer",
        "reviewer_count": 1,
        "reviewer_model": "gpt-5.6-luna",
        "reviewer_effort": "xhigh",
        "must_observe": [
          "historical v2 snapshot은 immutable provenance이며 현재 v3 계약 문서가 아님"
        ],
        "must_not": [
          "코드 버전이 다르다는 이유만으로 snapshot 수정",
          "일반 리뷰 5인 team 생성"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 1
      }
    },
    {
      "id": "provider-explicit-scope",
      "fixture": "review-service",
      "profile": "engineering",
      "kind": "review",
      "sandbox": "read-only",
      "benchmark": false,
      "prompt": "src/provider.ts의 runWithProvider에서 provider session cleanup과 그 provider 호출의 오류 경로만 집중 리뷰해줘. 파일은 수정하지 마.",
      "expected": {
        "skill_route": "engineering:review-failure-modes",
        "review_mode": "single-fresh-delegated-reviewer",
        "reviewer_count": 1,
        "reviewer_model": "gpt-5.6-luna",
        "reviewer_effort": "xhigh",
        "must_find": [
          "provider-session-leak"
        ],
        "must_not": [
          "external-payload-cast 또는 다른 webhook finding 추가",
          "일반 리뷰 5인 team 생성"
        ]
      },
      "evaluation_control": {
        "reviewer_count": 1
      }
    }
  ]
}
