{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsu.dev/schemas/design-quality-report-v1.json",
  "title": "Design Quality Report",
  "type": "object",
  "required": [
    "schema_version", "contract_id", "contract_revision", "contract_digest", "profile", "artifact",
    "scope_status", "end_to_end_status", "claim_level", "gates", "evaluator_runs", "metric_results",
    "outcome_evidence", "findings"
  ],
  "properties": {
    "schema_version": {"const": "design-quality-report-v1"},
    "contract_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "contract_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"enum": ["interface-design", "operations-ui", "figma-workflow"]},
    "artifact": {
      "type": "object",
      "required": ["scope", "revision", "locators"],
      "properties": {
        "scope": {"enum": ["proposal", "figma", "implementation", "live"]},
        "revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "locators": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    },
    "scope_status": {"$ref": "#/$defs/status"},
    "end_to_end_status": {"$ref": "#/$defs/status"},
    "claim_level": {"enum": ["provisional", "validated"]},
    "gates": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/gate"}},
    "evaluator_runs": {"type": "array", "items": {"$ref": "#/$defs/evaluator"}},
    "metric_results": {"type": "array", "items": {"$ref": "#/$defs/metricResult"}},
    "outcome_evidence": {"type": "array", "items": {"$ref": "#/$defs/outcomeEvidence"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "extensions": {
      "type": "object",
      "properties": {
        "operations": {"$ref": "#/$defs/operationsExtension"},
        "interface": {"$ref": "#/$defs/interfaceExtension"},
        "figma": {"$ref": "#/$defs/figmaReportExtension"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "status": {"enum": ["passed", "failed", "blocked", "inconclusive", "not_run", "not_applicable", "accepted_risk"]},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
        {"pattern": "^[\\\\/]"},
          {"pattern": "^[A-Za-z]:[\\\\/]"},
          {"pattern": ":[\\\\/]{2}"},
          {"pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"},
          {"pattern": "\\u0000"}
        ]
      }
    },
    "relativePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "nonEmptyRelativePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "semanticTokenIdentifier": {
      "type": "string",
      "pattern": "^(?:--[A-Za-z_][A-Za-z0-9_.:/-]*|[A-Za-z_][A-Za-z0-9_]*(?:[._:/-][A-Za-z0-9_]+)+)$"
    },
    "check": {
      "type": "object",
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/relativePaths"},
        "exclusion_id": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "required", "status", "score", "evidence", "checks"],
      "properties": {
        "id": {"type": "string", "pattern": "^DQ[0-8]$"},
        "required": {"type": "boolean"},
        "status": {"$ref": "#/$defs/status"},
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
        "evidence": {"$ref": "#/$defs/relativePaths"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      },
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["evaluator_id", "relationship", "evaluated_at", "artifact_revision", "contract_digest", "scores", "evidence"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "relationship": {"enum": ["author", "independent"]},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "artifact_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scores": {
          "type": "object",
          "properties": {
            "DQ1": {"type": "integer", "minimum": 0, "maximum": 4},
            "DQ2": {"type": "integer", "minimum": 0, "maximum": 4},
            "DQ3": {"type": "integer", "minimum": 0, "maximum": 4},
            "DQ4": {"type": "integer", "minimum": 0, "maximum": 4},
            "DQ5": {"type": "integer", "minimum": 0, "maximum": 4},
            "DQ6": {"type": "integer", "minimum": 0, "maximum": 4}
          },
          "additionalProperties": false
        },
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    },
    "metricResult": {
      "type": "object",
      "required": ["metric_id", "run_id", "observed_at", "artifact_revision", "observed", "status", "evidence"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observed_at": {"type": "string", "format": "date-time"},
        "artifact_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observed": {"type": "number"},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    },
    "outcomeEvidence": {
      "type": "object",
      "required": [
        "id", "run_id", "observed_at", "artifact_revision", "kind", "status", "participant_count",
        "plan_id", "scenario_ids", "metric_ids", "participant_criteria", "planned_participant_count",
        "protocol", "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observed_at": {"type": "string", "format": "date-time"},
        "artifact_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "kind": {"enum": ["independent-walkthrough", "representative-user-test", "production-behavior", "domain-safety-review"]},
        "status": {"$ref": "#/$defs/status"},
        "participant_count": {"type": "integer", "minimum": 1},
        "plan_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "scenario_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "metric_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "participant_criteria": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "planned_participant_count": {"type": "integer", "minimum": 1},
        "protocol": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "gate_id", "severity", "status", "summary", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "gate_id": {"type": "string", "pattern": "^DQ[0-8]$"},
        "severity": {"enum": ["critical", "major", "minor"]},
        "status": {"enum": ["open", "resolved", "accepted_risk"]},
        "summary": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    },
    "operationsExtension": {
      "type": "object",
      "required": ["design_system_mapping", "browser_receipts"],
      "properties": {
        "design_system_mapping": {
          "type": "object",
          "required": ["system_id", "token_source", "mappings"],
          "properties": {
            "system_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "token_source": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "mappings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["representation_ids", "semantic_role", "token_id", "evidence"],
                "properties": {
                  "representation_ids": {"$ref": "#/$defs/nonEmptyStrings"},
                  "semantic_role": {"type": "string", "minLength": 1, "pattern": "\\S"},
                  "token_id": {"$ref": "#/$defs/semanticTokenIdentifier"},
                  "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "browser_receipts": {
          "type": "array",
          "items": {"$ref": "#/$defs/browserReceipt"}
        }
      },
      "additionalProperties": false
    },
    "browserReceipt": {
      "type": "object",
      "required": [
        "scenario_id", "environment_id", "command", "build_or_revision", "url", "status",
        "actions", "expected", "observed", "screenshots", "console_runtime_errors"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "environment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "build_or_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"$ref": "#/$defs/status"},
        "actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "expected": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observed": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "screenshots": {"$ref": "#/$defs/nonEmptyRelativePaths"},
        "console_runtime_errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "interfaceExtension": {
      "type": "object",
      "required": ["runtime_receipts"],
      "properties": {
        "runtime_receipts": {"type": "array", "items": {"$ref": "#/$defs/interfaceRuntimeReceipt"}}
      },
      "additionalProperties": false
    },
    "interfaceRuntimeReceipt": {
      "type": "object",
      "required": [
        "scenario_id", "environment_id", "command", "build_or_revision", "url", "status",
        "steps", "expected", "observed", "screenshots", "console_runtime_errors"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "environment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "build_or_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"$ref": "#/$defs/status"},
        "steps": {"$ref": "#/$defs/nonEmptyStrings"},
        "expected": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "observed": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "screenshots": {"$ref": "#/$defs/nonEmptyRelativePaths"},
        "console_runtime_errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "figmaReportExtension": {
      "type": "object",
      "required": ["native_receipts"],
      "properties": {
        "native_receipts": {"type": "array", "items": {"$ref": "#/$defs/figmaNativeReceipt"}}
      },
      "additionalProperties": false
    },
    "figmaNativeReceipt": {
      "type": "object",
      "required": [
        "scenario_id", "environment_id", "artifact_revision", "status", "node_ids", "capabilities",
        "structure_observed", "resize_scenario_ids", "prototype_scenario_ids", "evidence"
      ],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "environment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "artifact_revision": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "status": {"$ref": "#/$defs/status"},
        "node_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "capabilities": {"$ref": "#/$defs/nonEmptyStrings"},
        "structure_observed": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "resize_scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "prototype_scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "operations-ui"}}, "required": ["profile"]},
      "then": {"required": ["extensions"], "properties": {"extensions": {"required": ["operations"]}}},
      "else": {"properties": {"extensions": {"not": {"required": ["operations"]}}}}
    },
    {
      "if": {
        "properties": {
          "profile": {"const": "interface-design"},
          "artifact": {"properties": {"scope": {"enum": ["implementation", "live"]}}, "required": ["scope"]}
        },
        "required": ["profile", "artifact"]
      },
      "then": {"required": ["extensions"], "properties": {"extensions": {"required": ["interface"]}}},
      "else": {"properties": {"extensions": {"not": {"required": ["interface"]}}}}
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {"profile": {"const": "figma-workflow"}},
            "required": ["profile"]
          },
          {
            "properties": {"artifact": {"properties": {"scope": {"const": "figma"}}, "required": ["scope"]}},
            "required": ["artifact"]
          }
        ]
      },
      "then": {"required": ["extensions"], "properties": {"extensions": {"required": ["figma"]}}},
      "else": {"properties": {"extensions": {"not": {"required": ["figma"]}}}}
    }
  ],
  "additionalProperties": false
}
