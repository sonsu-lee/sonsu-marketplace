#!/usr/bin/env bash
# Freeze and verify evidence-only inputs for a fresh round-2-5 fix implementer.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  fix-handoff create --brief FILE --artifact FILE --revision GIT_REVISION --findings FILE --verification FILE --round 2|3|4|5 [--output FILE]
  fix-handoff verify BUNDLE SHA256
EOF
  exit 2
}

run_python() {
  python3 - "$@" <<'PY'
import hashlib
import io
import json
import os
import re
import secrets
import shutil
import stat
import sys
import tarfile
import tempfile

mode = sys.argv[1]
FORMAT = "engineering-fix-handoff-v1"
MEMBERS = ("metadata.json", "task-brief", "artifact-package", "findings.json", "verification.json")
FORBIDDEN = {
    "severity", "verdict", "reviewer", "agent", "cause", "rationale",
    "suggested_fix", "recommendation", "status", "conclusion", "authority",
}

def fail(message):
    print(f"fix-handoff {mode}: {message}", file=sys.stderr)
    raise SystemExit(2)

def exact_keys(value, expected, label):
    if not isinstance(value, dict):
        fail(f"{label} must be an object")
    actual = set(value)
    if actual != set(expected):
        named = sorted(actual & FORBIDDEN)
        if named:
            fail(f"{label} includes forbidden fields: {', '.join(named)}")
        fail(f"{label} has missing or unrecognized keys")

def string_list(value, label):
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        fail(f"{label} must be an array of strings")

def parse_json(data, label):
    try:
        return json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail(f"{label} is malformed JSON")

def validate_findings(data):
    value = parse_json(data, "findings")
    exact_keys(value, ("schema", "findings"), "findings envelope")
    if not isinstance(value["schema"], str) or value["schema"] != "finding-evidence.v1":
        fail("findings schema is invalid")
    if not isinstance(value["findings"], list):
        fail("findings must be an array")
    for index, finding in enumerate(value["findings"]):
        label = f"finding {index}"
        exact_keys(finding, (
            "id", "observed_mismatch", "expected_contract", "artifact_locations",
            "reproduction", "raw_evidence", "unknowns",
        ), label)
        for key in ("id", "observed_mismatch", "expected_contract", "reproduction", "raw_evidence"):
            if not isinstance(finding[key], str):
                fail(f"{label}.{key} must be a string")
        string_list(finding["artifact_locations"], f"{label}.artifact_locations")
        string_list(finding["unknowns"], f"{label}.unknowns")

def validate_verification(data):
    value = parse_json(data, "verification")
    exact_keys(value, ("schema", "checks", "unknowns"), "verification envelope")
    if not isinstance(value["schema"], str) or value["schema"] != "verification-evidence.v1":
        fail("verification schema is invalid")
    if not isinstance(value["checks"], list):
        fail("checks must be an array")
    string_list(value["unknowns"], "verification unknowns")
    for index, check in enumerate(value["checks"]):
        label = f"check {index}"
        exact_keys(check, ("command", "exit_code", "output_reference", "observed_result"), label)
        for key in ("command", "output_reference", "observed_result"):
            if not isinstance(check[key], str):
                fail(f"{label}.{key} must be a string")
        if not isinstance(check["exit_code"], int) or isinstance(check["exit_code"], bool):
            fail(f"{label}.exit_code must be an integer")

def validate_metadata(data):
    value = parse_json(data, "metadata")
    exact_keys(value, ("format", "round", "revision"), "metadata")
    if not isinstance(value["format"], str) or value["format"] != FORMAT:
        fail("metadata format is invalid")
    if value["round"] not in (2, 3, 4, 5) or isinstance(value["round"], bool):
        fail("metadata round is invalid")
    if not isinstance(value["revision"], str) or not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", value["revision"]):
        fail("metadata revision is invalid")

def validate_artifact_revision(data, revision):
    """Bind a review package's revision to its exact artifact representation.

    The canonical review-package helper starts committed ranges with a fixed
    four-line header.  Treat only that unambiguous form as a git-range package;
    every other (including binary) artifact is content-addressed instead.
    """
    content_digest = hashlib.sha256(data).hexdigest()
    try:
        lines = data.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        lines = []

    if len(lines) >= 2 and lines[0] == "# Review package" and lines[1] == "Mode: committed range":
        header = []
        for line in lines[2:]:
            if line == "":
                break
            header.append(line)

        bases = [line for line in header if line.startswith("Base:")]
        heads = [line for line in header if line.startswith("Head:")]
        if len(bases) != 1 or len(heads) != 1:
            fail("committed-range artifact has missing or duplicate Base/Head headers")
        base = bases[0]
        head = heads[0]
        if not re.fullmatch(r"Base: [0-9a-f]{40}", base) or not re.fullmatch(r"Head: [0-9a-f]{40}", head):
            fail("committed-range artifact has malformed Base/Head headers")
        if revision != head.removeprefix("Head: "):
            fail("committed-range artifact Head does not match revision")
        return

    if revision != content_digest:
        fail("non-committed-range artifact SHA-256 does not match revision")

def read_regular(path, label):
    try:
        info = os.lstat(path)
    except OSError:
        fail(f"{label} is missing or unreadable: {path}")
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_size == 0:
        fail(f"{label} is not a non-empty regular file: {path}")
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except OSError:
        fail(f"{label} is missing or unreadable: {path}")

def validate_parent(path):
    parent = os.path.dirname(path)
    try:
        info = os.lstat(parent)
    except OSError:
        fail(f"output parent does not exist: {parent}")
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail(f"output parent is not a directory: {parent}")
    return parent

def hash_and_sync(path):
    try:
        with open(path, "rb") as handle:
            os.fsync(handle.fileno())
            digest = hashlib.sha256()
            while True:
                chunk = handle.read(1024 * 1024)
                if not chunk:
                    return digest.hexdigest()
                digest.update(chunk)
    except OSError as error:
        fail(f"cannot hash and sync staging bundle: {error}")

def cleanup_file(path):
    if path:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError:
            pass

if mode == "create":
    if len(sys.argv) != 9:
        fail("invalid create arguments")
    brief, artifact, revision, findings_path, verification_path, round_text, explicit_output = sys.argv[2:]
    if not re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})?", revision):
        fail("revision must be exactly 40 or 64 lowercase hexadecimal characters")
    if round_text not in {"2", "3", "4", "5"}:
        fail("round must be 2, 3, 4 or 5")

    # Read and validate every source before any output path is reserved.
    brief_data = read_regular(brief, "brief")
    artifact_data = read_regular(artifact, "artifact")
    findings_data = read_regular(findings_path, "findings")
    verification_data = read_regular(verification_path, "verification")
    validate_findings(findings_data)
    validate_verification(verification_data)
    validate_artifact_revision(artifact_data, revision)

    if explicit_output:
        final = os.path.abspath(explicit_output)
        parent = validate_parent(final)
        if os.path.lexists(final):
            fail(f"output already exists: {final}")
    else:
        parent = validate_parent(os.path.join(os.path.abspath(os.environ.get("TMPDIR", tempfile.gettempdir())), "placeholder"))
        final = None

    metadata = json.dumps({"format": FORMAT, "round": int(round_text), "revision": revision},
                          sort_keys=True, separators=(",", ":")).encode("utf-8")
    payloads = {
        "metadata.json": metadata,
        "task-brief": brief_data,
        "artifact-package": artifact_data,
        "findings.json": findings_data,
        "verification.json": verification_data,
    }
    stage = None
    try:
        fd, stage = tempfile.mkstemp(prefix=".engineering-fix-handoff-stage.", suffix=".tar", dir=parent)
        with os.fdopen(fd, "wb") as fileobj:
            with tarfile.open(fileobj=fileobj, mode="w", format=tarfile.USTAR_FORMAT) as archive:
                for name in MEMBERS:
                    data = payloads[name]
                    member = tarfile.TarInfo(name)
                    member.size = len(data)
                    member.mode = 0o600
                    member.mtime = 0
                    archive.addfile(member, io.BytesIO(data))
            fileobj.flush()
            os.fsync(fileobj.fileno())
        digest = hash_and_sync(stage)

        if final is None:
            for _ in range(128):
                candidate = os.path.join(parent, f"engineering-fix-handoff.{secrets.token_hex(16)}.tar")
                try:
                    os.link(stage, candidate)
                except FileExistsError:
                    continue
                except OSError as error:
                    fail(f"cannot publish unique output: {error}")
                final = candidate
                break
            if final is None:
                fail("cannot reserve a unique output path")
        else:
            try:
                os.link(stage, final)
            except FileExistsError:
                fail(f"output already exists: {final}")
            except OSError as error:
                fail(f"cannot publish output: {error}")
    except BaseException:
        cleanup_file(stage)
        raise
    else:
        cleanup_file(stage)

    print(f"Bundle: {final}")
    print(f"Revision: sha256:{digest}")

elif mode == "verify":
    if len(sys.argv) != 4:
        fail("invalid verify arguments")
    bundle, expected_digest = sys.argv[2:]
    if not re.fullmatch(r"[0-9a-f]{64}", expected_digest):
        fail("digest must be 64 lowercase hexadecimal characters")

    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        fd = os.open(bundle, flags)
    except OSError:
        fail(f"bundle is missing or unreadable: {bundle}")
    try:
        with os.fdopen(fd, "rb") as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
                fail(f"bundle is not a non-empty regular file: {bundle}")
            snapshot = handle.read()
    except OSError:
        fail(f"bundle is missing or unreadable: {bundle}")

    actual_digest = hashlib.sha256(snapshot).hexdigest()
    if actual_digest != expected_digest:
        fail("bundle digest mismatch")

    try:
        with tarfile.open(fileobj=io.BytesIO(snapshot), mode="r:*") as archive:
            members = archive.getmembers()
            names = [member.name for member in members]
            if len(names) != len(MEMBERS) or set(names) != set(MEMBERS) or len(set(names)) != len(names):
                fail("archive has unsafe, missing, duplicate, or extra members")
            payloads = {}
            for member in members:
                if not member.isreg() or member.size <= 0:
                    fail("archive contains an unsafe or empty member")
                source = archive.extractfile(member)
                if source is None:
                    fail("archive member cannot be read")
                data = source.read()
                if len(data) != member.size:
                    fail("archive member is truncated")
                payloads[member.name] = data
    except (tarfile.TarError, OSError):
        fail("bundle archive is malformed")

    validate_metadata(payloads["metadata.json"])
    validate_findings(payloads["findings.json"])
    validate_verification(payloads["verification.json"])
    metadata = parse_json(payloads["metadata.json"], "metadata")
    validate_artifact_revision(payloads["artifact-package"], metadata["revision"])

    extracted = None
    try:
        extracted = tempfile.mkdtemp(prefix="engineering-fix-handoff-extract.")
        os.chmod(extracted, 0o700)
        for name in MEMBERS:
            path = os.path.join(extracted, name)
            file_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            if hasattr(os, "O_NOFOLLOW"):
                file_flags |= os.O_NOFOLLOW
            fd = os.open(path, file_flags, 0o600)
            with os.fdopen(fd, "wb") as handle:
                handle.write(payloads[name])
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(path, 0o600)
    except BaseException:
        if extracted:
            shutil.rmtree(extracted, ignore_errors=True)
        raise

    print(f"Verified: {os.path.abspath(bundle)}")
    print(f"Revision: sha256:{actual_digest}")
    print(f"Extracted: {os.path.abspath(extracted)}")

else:
    fail("unknown mode")
PY
}

[[ $# -ge 1 ]] || usage
mode=$1
shift

case "$mode" in
  create)
    brief=''
    artifact=''
    revision=''
    findings=''
    verification=''
    round=''
    output=''
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --brief|--artifact|--revision|--findings|--verification|--round|--output)
          [[ $# -ge 2 ]] || usage
          case "$1" in
            --brief) brief=$2 ;;
            --artifact) artifact=$2 ;;
            --revision) revision=$2 ;;
            --findings) findings=$2 ;;
            --verification) verification=$2 ;;
            --round) round=$2 ;;
            --output) output=$2 ;;
          esac
          shift 2
          ;;
        *) usage ;;
      esac
    done
    [[ -n "$brief" && -n "$artifact" && -n "$revision" && -n "$findings" && -n "$verification" && -n "$round" ]] || usage
    run_python create "$brief" "$artifact" "$revision" "$findings" "$verification" "$round" "$output"
    ;;
  verify)
    [[ $# -eq 2 ]] || usage
    run_python verify "$1" "$2"
    ;;
  *) usage ;;
esac
