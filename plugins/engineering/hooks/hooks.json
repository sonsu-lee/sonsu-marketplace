{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(compact|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "plugin_root=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" && test -n \"$plugin_root\" && python3 \"$plugin_root/scripts/task-continuity.py\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "plugin_root=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" && test -n \"$plugin_root\" && python3 \"$plugin_root/scripts/evidence-gates.py\" hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
