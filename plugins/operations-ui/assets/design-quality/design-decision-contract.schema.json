{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsu.dev/schemas/design-decision-contract-v1.json",
  "title": "Design Decision Contract",
  "type": "object",
  "required": [
    "schema_version", "id", "profile", "artifact_scope", "mode", "revision", "locked_at",
    "actors", "contexts", "environments", "primary_question", "intended_outcome", "risk_profile",
    "task_scenarios", "information_requirements", "representation_map", "states", "metric_targets", "outcome_plan",
    "unresolved_decisions", "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "design-decision-contract-v1"},
    "id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["interface-design", "operations-ui", "figma-workflow"]},
    "artifact_scope": {"enum": ["proposal", "figma", "implementation", "live"]},
    "mode": {"enum": ["greenfield", "redesign", "audit"]},
    "revision": {"type": "string", "minLength": 1},
    "locked_at": {"type": "string", "format": "date-time"},
    "actors": {"$ref": "#/$defs/nonEmptyStrings"},
    "contexts": {"$ref": "#/$defs/nonEmptyStrings"},
    "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/environment"}},
    "primary_question": {"type": "string", "minLength": 1},
    "intended_outcome": {"type": "string", "minLength": 1},
    "risk_profile": {"$ref": "#/$defs/riskProfile"},
    "task_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskScenario"}},
    "information_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/information"}},
    "representation_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/representation"}},
    "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}},
    "metric_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metricTarget"}},
    "outcome_plan": {"$ref": "#/$defs/outcomePlan"},
    "unresolved_decisions": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}},
    "extensions": {"$ref": "#/$defs/contractExtensions"}
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment": {
      "type": "object",
      "required": ["id", "platform", "input_methods", "locale", "writing_mode", "accessibility_profile"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "platform": {"enum": ["web", "ios", "android", "desktop", "other"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "input_methods": {"$ref": "#/$defs/nonEmptyStrings"},
        "locale": {"type": "string", "minLength": 1},
        "writing_mode": {"enum": ["horizontal-tb", "vertical-rl", "vertical-lr"]},
        "accessibility_profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "riskProfile": {
      "type": "object",
      "required": ["level", "factors", "rationale"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "factors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "taskScenario": {
      "type": "object",
      "required": ["id", "actor", "starting_context", "task", "correct_outcome", "wrong_outcome", "wrong_outcome_cost", "information_ids", "representation_ids", "environment_ids", "observable_success"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "starting_context": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "correct_outcome": {"type": "string", "minLength": 1},
        "wrong_outcome": {"type": "string", "minLength": 1},
        "wrong_outcome_cost": {"type": "string", "minLength": 1},
        "information_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "representation_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "environment_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "observable_success": {"type": "string", "minLength": 1},
        "requirement_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "coverage": {"$ref": "#/$defs/operationsCoverage"}
      },
      "additionalProperties": false
    },
    "information": {
      "type": "object",
      "required": ["id", "role", "meaning", "source", "freshness", "uncertainty", "task_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"enum": ["must_know", "supporting", "on_demand"]},
        "meaning": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "freshness": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "string", "minLength": 1},
        "task_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "required": ["id", "information_ids", "kind", "semantic_role", "non_color_signals", "rationale", "task_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "information_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "kind": {"type": "string", "minLength": 1},
        "semantic_role": {"type": "string", "minLength": 1},
        "non_color_signals": {"$ref": "#/$defs/nonEmptyStrings"},
        "rationale": {"type": "string", "minLength": 1},
        "task_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["id", "applicable", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "applicable": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "reachability_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "metricTarget": {
      "type": "object",
      "required": ["id", "kind", "role", "operator", "target", "unit", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["coverage", "count", "rate", "duration", "rubric"]},
        "role": {"enum": ["primary", "guardrail"]},
        "operator": {"enum": [">=", ">", "<=", "<", "=="]},
        "target": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["coverage", "rate"]}}, "required": ["kind"]},
          "then": {"properties": {"target": {"minimum": 0, "maximum": 1}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["count", "duration"]}}, "required": ["kind"]},
          "then": {"properties": {"target": {"minimum": 0}}}
        },
        {
          "if": {"properties": {"kind": {"const": "rubric"}}, "required": ["kind"]},
          "then": {"properties": {"target": {"minimum": 0, "maximum": 4}}}
        },
        {
          "if": {"properties": {"id": {"const": "critical-harm"}}, "required": ["id"]},
          "then": {
            "properties": {
              "kind": {"const": "count"},
              "role": {"const": "guardrail"},
              "operator": {"const": "=="},
              "target": {"const": 0}
            }
          }
        }
      ]
    },
    "outcomePlan": {
      "type": "object",
      "required": ["id", "scenario_ids", "metric_ids", "participant_criteria", "planned_participant_count", "protocol", "rationale"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scenario_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "metric_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "participant_criteria": {"type": "string", "minLength": 1},
        "planned_participant_count": {"type": "integer", "minimum": 1},
        "protocol": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["id", "severity", "reason", "evidence_needed", "gate_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "major", "minor"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_needed": {"type": "string", "minLength": 1},
        "gate_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["id", "check_ids", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "content-and-localization-resilience"}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operationsCoverage": {
      "type": "object",
      "required": ["jobs", "entities", "lifecycle", "actions", "permissions", "risks", "states"],
      "properties": {
        "jobs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "entities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "lifecycle": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "states": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "operationsRequirement": {
      "type": "object",
      "required": ["id", "text", "scenario_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "scenario_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "currentBehavior": {
      "type": "object",
      "required": ["id", "kind", "observed", "evidence", "decision", "reason", "implementation_target", "scenario_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["feature", "state", "action", "permission", "data-shape"]},
        "observed": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/nonEmptyStrings"},
        "decision": {"enum": ["preserve", "change"]},
        "reason": {"type": "string", "minLength": 1},
        "implementation_target": {"type": "string", "minLength": 1},
        "scenario_ids": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "changeContract": {
      "type": "object",
      "required": ["id", "inventory_ids", "requirement_ids", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inventory_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "requirement_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operationsExtension": {
      "type": "object",
      "required": ["surface", "jobs", "entities", "lifecycle", "actions", "permissions", "risks", "requirements"],
      "properties": {
        "surface": {"enum": ["standalone-console", "embedded-view"]},
        "jobs": {"$ref": "#/$defs/nonEmptyStrings"},
        "entities": {"$ref": "#/$defs/nonEmptyStrings"},
        "lifecycle": {"$ref": "#/$defs/nonEmptyStrings"},
        "actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "permissions": {"$ref": "#/$defs/nonEmptyStrings"},
        "risks": {"$ref": "#/$defs/nonEmptyStrings"},
        "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operationsRequirement"}},
        "current_behavior_inventory": {"type": "array", "items": {"$ref": "#/$defs/currentBehavior"}},
        "change_contract": {"type": "array", "items": {"$ref": "#/$defs/changeContract"}}
      },
      "additionalProperties": false
    },
    "figmaScenario": {
      "type": "object",
      "required": ["id", "scenario_id", "environment_id", "expectation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "expectation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "figmaExtension": {
      "type": "object",
      "required": ["target", "required_capabilities", "component_strategy", "resize_scenarios", "prototype_scenarios"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "required_capabilities": {"$ref": "#/$defs/nonEmptyStrings"},
        "component_strategy": {"type": "string", "minLength": 1},
        "resize_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/figmaScenario"}},
        "prototype_scenarios": {"type": "array", "items": {"$ref": "#/$defs/figmaScenario"}}
      },
      "additionalProperties": false
    },
    "contractExtensions": {
      "type": "object",
      "properties": {
        "operations": {"$ref": "#/$defs/operationsExtension"},
        "figma": {"$ref": "#/$defs/figmaExtension"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "operations-ui"}}, "required": ["profile"]},
      "then": {
        "required": ["extensions"],
        "properties": {
          "task_scenarios": {
            "items": {"required": ["requirement_ids", "actions", "coverage"]}
          },
          "extensions": {"required": ["operations"]}
        }
      },
      "else": {
        "properties": {
          "task_scenarios": {
            "items": {
              "not": {
                "anyOf": [
                  {"required": ["requirement_ids"]},
                  {"required": ["actions"]},
                  {"required": ["coverage"]}
                ]
              }
            }
          },
          "extensions": {"not": {"required": ["operations"]}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {"const": "operations-ui"},
          "mode": {"const": "redesign"}
        },
        "required": ["profile", "mode"]
      },
      "then": {
        "properties": {
          "extensions": {
            "properties": {
              "operations": {
                "required": ["current_behavior_inventory", "change_contract"],
                "properties": {
                  "current_behavior_inventory": {"minItems": 1},
                  "change_contract": {"minItems": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {"properties": {"profile": {"const": "figma-workflow"}}, "required": ["profile"]},
          {"properties": {"artifact_scope": {"const": "figma"}}, "required": ["artifact_scope"]}
        ]
      },
      "then": {
        "required": ["extensions"],
        "properties": {"extensions": {"required": ["figma"]}}
      },
      "else": {
        "properties": {"extensions": {"not": {"required": ["figma"]}}}
      }
    }
  ],
  "additionalProperties": false
}
