{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsu.dev/schemas/operations-ui-quality-report-v1.json",
  "title": "Operations UI Quality Report",
  "type": "object",
  "required": ["schema_version", "screen_contract_id", "overall", "design_profile", "gates", "browser_receipts"],
  "properties": {
    "schema_version": {"const": "operations-ui-quality-report-v1"},
    "screen_contract_id": {"type": "string", "minLength": 1},
    "overall": {"enum": ["passed", "failed", "blocked", "inconclusive", "not_run"]},
    "design_profile": {
      "type": "object",
      "required": ["name", "canvas", "surface", "sidebar", "primary", "sidebar_width", "topbar_height", "content_padding", "section_gap", "control_height", "table_row_height", "radius"],
      "properties": {
        "name": {"const": "precision-operations-console-v1"},
        "canvas": {"const": "#F4F6F8"},
        "surface": {"const": "#FFFFFF"},
        "sidebar": {"const": "#1D2B3C"},
        "primary": {"const": "#356BD6"},
        "sidebar_width": {"const": 240},
        "topbar_height": {"const": 48},
        "content_padding": {"const": 24},
        "section_gap": {"const": 16},
        "control_height": {"const": 36},
        "table_row_height": {"const": 48},
        "radius": {"const": 10}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/g0"}, {"$ref": "#/$defs/g1"},
        {"$ref": "#/$defs/g2"}, {"$ref": "#/$defs/g3"},
        {"$ref": "#/$defs/g4"}, {"$ref": "#/$defs/g5"},
        {"$ref": "#/$defs/g6"}, {"$ref": "#/$defs/g7"}
      ],
      "items": false
    },
    "browser_receipts": {
      "type": "array",
      "items": {"$ref": "#/$defs/browserReceipt"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"overall": {"const": "passed"}}},
      "then": {"properties": {"browser_receipts": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonEmptyRelativePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "anyOf": [
            {"pattern": "^/"},
            {"pattern": "^[A-Za-z]:[\\\\/]"},
            {"pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"}
          ]
        }
      }
    },
    "status": {"enum": ["passed", "failed", "blocked", "inconclusive", "not_run"]},
    "check": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "blocked", "inconclusive", "not_run", "not_applicable"]},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"},
        "exclusion_id": {"type": "string", "minLength": 1},
        "not_applicable_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gateBase": {
      "type": "object",
      "required": ["id", "required", "status", "evidence", "checks"],
      "properties": {
        "id": {"type": "string"},
        "required": {"const": true},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"$ref": "#/$defs/nonEmptyRelativePaths"},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}
      },
      "additionalProperties": false
    },
    "g0": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G0"}}}]},
    "g1": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G1"}}}]},
    "g2": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G2"}}}]},
    "g3": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G3"}}}]},
    "g4": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G4"}}}]},
    "g5": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G5"}}}]},
    "g6": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G6"}}}]},
    "g7": {"allOf": [{"$ref": "#/$defs/gateBase"}, {"properties": {"id": {"const": "G7"}}}]},
    "browserReceipt": {
      "type": "object",
      "required": ["scenario_id", "command", "build_or_revision", "url", "viewport_id", "status", "actions", "expected", "observed", "screenshots", "console_runtime_errors"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "build_or_revision": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "viewport_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "actions": {"$ref": "#/$defs/nonEmptyStrings"},
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "screenshots": {"$ref": "#/$defs/nonEmptyRelativePaths"},
        "console_runtime_errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
